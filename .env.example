# Langfuse Cloud — sign up at https://cloud.langfuse.com, create a project, copy keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenRouter — primary provider, free tier (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick any current ":free" tool-calling model from https://openrouter.ai/models?q=free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Ollama — local fallback, OpenAI-compatible endpoint (default port 11434)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
